# Server-side keys for the API routes in api/ (Vercel functions). They are
# read only on the server and never reach the client bundle, so they must NOT
# have a VITE_ prefix.
#
# Production: set them in Vercel → Project → Settings → Environment Variables.
# Local `npm run dev`: copy this file to .env and fill them in; the dev server
# hands them to the api/ handlers.

# Required for classify, chat and ortak-plan (they answer 503 without it).
GEMINI_API_KEY=

# Optional: nearby place suggestions in classify; skipped when empty.
FOURSQUARE_API_KEY=

# Optional: overrides the Gemini model (default: gemini-3.5-flash-lite).
GEMINI_MODEL=

# Email verification for new accounts (api/eposta.ts). Leave all three empty
# to turn it off; the app then lets accounts in without an email.
# A long random secret (at least 32 characters), e.g. `openssl rand -hex 32`.
# Every verification is tied to it: changing it asks everyone to verify again.
EPOSTA_GIZLI=
# The Gmail account codes are sent from, and a Google app password for it
# (myaccount.google.com/apppasswords, needs 2-Step Verification). Not the
# account's own password.
GMAIL_ADRESI=
GMAIL_UYGULAMA_SIFRESI=
