<?xml version="1.0" encoding="utf-8"?>
<!-- Footer page 1: the live countdown (or progress while the plan is on). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <Chronometer
        android:id="@+id/plan_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_glass"
        android:fontFamily="sans-serif-medium"
        android:fontFeatureSettings="tnum"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/plan_far"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_glass"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/plan_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:layout_weight="1"
        android:max="100"
        android:progressDrawable="@drawable/widget_progress"
        android:visibility="gone" />

    <TextView
        android:id="@+id/plan_time_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textColor="#D9FFFFFF"
        android:textSize="13sp" />
</LinearLayout>
