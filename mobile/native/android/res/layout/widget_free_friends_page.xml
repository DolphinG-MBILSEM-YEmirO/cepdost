<?xml version="1.0" encoding="utf-8"?>
<!-- One page of free friends (up to three faces). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/friend_slot_0"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/friend_face_0"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/friend_name_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:textColor="#262137"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/friend_until_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#059669"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/friend_slot_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/friend_face_1"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/friend_name_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:textColor="#262137"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/friend_until_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#059669"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/friend_slot_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/friend_face_2"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/friend_name_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:textColor="#262137"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/friend_until_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#059669"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
